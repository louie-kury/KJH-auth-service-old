# .env로 복사한 뒤 로컬 MySQL 비밀번호를 변경하세요.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LOCAL_ROOT_PASSWORD
MYSQL_PASSWORD=REPLACE_WITH_LOCAL_SERVICE_PASSWORD
MYSQL_HOST_PORT=3307

# 호스트에서 실행하는 Spring Boot에는 셸이나 IDE에서 별도로 지정하세요.
MYSQL_URL=jdbc:mysql://127.0.0.1:3307/louie_kury_auth_dev
MYSQL_USERNAME=auth_service
MONGODB_URI=REPLACE_WITH_ATLAS_CONNECTION_URI
MONGODB_DATABASE=louie_kury_auth_dev
